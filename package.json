{
  "name": "russelldsmith",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "content:scrape": "tsx scripts/scrape.ts",
    "content:recover": "tsx scripts/recover-wayback.ts",
    "content:manifest": "tsx scripts/build-manifest.ts",
    "gen:redirect": "tsx scripts/gen-redirect-worker.ts",
    "test:redirects": "tsx scripts/gen-redirect-worker.ts && tsx scripts/build-manifest.ts && tsx scripts/test-redirects.ts",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.3",
    "next": "16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/turndown": "^5.0.5",
    "cheerio": "^1.2.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "p-limit": "^7.3.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.4",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "typescript": "^5",
    "wrangler": "^4.118.0"
  }
}
